# Copy to board/.env (read by netlify dev, the tests, the PC worker and the collector). Values are placeholders.
# Set the same names as environment variables on the Netlify site (all deploy contexts, not production only).

# Key the board page, the PC worker and Claude Code send as the x-key header. Use 40+ random characters.
PIPELINE_KEY=replace-with-a-long-random-string

# Shared secret the claude.ai routines send back as the x-secret header on their callbacks.
RESEARCH_SECRET=replace-with-another-long-random-string

# claude.ai routine "Job pipeline research" (sorter, grader, preparer, lessons): API trigger URL + token.
ROUTINE_FIRE_URL=https://your-routine-fire-url-from-claude.ai
ROUTINE_TOKEN=replace-with-the-routine-token

# Optional: claude.ai routine "Job pipeline mail" (lights up "Check now" on the board).
MAIL_FIRE_URL=
MAIL_TOKEN=

# Used only by worker/reviewer/deploy-board.mjs and credits.mjs (named in worker/reviewer/board-site.json).
NETLIFY_AUTH_TOKEN=replace-with-a-netlify-personal-access-token
